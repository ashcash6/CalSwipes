{
  "openapi": "3.1.0",
  "info": {
    "title": "Berkeley Dining Menu API",
    "version": "1.1.0"
  },
  "paths": {
    "/v1/auth/challenge": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Challenge",
        "operationId": "challenge_v1_auth_challenge_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChallengeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/apple": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Exchange",
        "operationId": "exchange_v1_auth_apple_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExchangeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/me": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Me",
        "operationId": "me_v1_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Logout",
        "operationId": "logout_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/health/live": {
      "get": {
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/menu": {
      "get": {
        "summary": "Menu",
        "operationId": "menu_v1_menu_get",
        "parameters": [
          {
            "name": "hall",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Hall"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Date"
            }
          },
          {
            "name": "meal",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Meal"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/menu": {
      "get": {
        "summary": "Menu",
        "operationId": "menu_menu_get",
        "parameters": [
          {
            "name": "hall",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Hall"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Date"
            }
          },
          {
            "name": "meal",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Meal"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "created_at"
        ],
        "title": "AccountResponse"
      },
      "ChallengeResponse": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "title": "Challenge Id"
          },
          "nonce": {
            "type": "string",
            "title": "Nonce"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "challenge_id",
          "nonce",
          "expires_at"
        ],
        "title": "ChallengeResponse"
      },
      "ExchangeRequest": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "format": "uuid",
            "title": "Challenge Id"
          },
          "identity_token": {
            "type": "string",
            "maxLength": 16384,
            "minLength": 20,
            "title": "Identity Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "challenge_id",
          "identity_token"
        ],
        "title": "ExchangeRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Hall": {
        "type": "string",
        "enum": [
          "crossroads",
          "cafe-3",
          "foothill",
          "clark-kerr"
        ],
        "title": "Hall"
      },
      "Item": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Categories"
          },
          "serving": {
            "$ref": "#/components/schemas/Serving"
          },
          "macros": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Macros"
              },
              {
                "type": "null"
              }
            ]
          },
          "nutrition_status": {
            "type": "string",
            "enum": [
              "published",
              "unapproved",
              "missing"
            ],
            "title": "Nutrition Status"
          },
          "reference_image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference Image Url"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "categories",
          "serving",
          "macros",
          "nutrition_status"
        ],
        "title": "Item"
      },
      "Macros": {
        "properties": {
          "calories_kcal": {
            "type": "number",
            "minimum": 0.0,
            "title": "Calories Kcal"
          },
          "protein_g": {
            "type": "number",
            "minimum": 0.0,
            "title": "Protein G"
          },
          "carbs_g": {
            "type": "number",
            "minimum": 0.0,
            "title": "Carbs G"
          },
          "fat_g": {
            "type": "number",
            "minimum": 0.0,
            "title": "Fat G"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "calories_kcal",
          "protein_g",
          "carbs_g",
          "fat_g"
        ],
        "title": "Macros"
      },
      "Meal": {
        "type": "string",
        "enum": [
          "breakfast",
          "lunch",
          "dinner",
          "late-night",
          "brunch"
        ],
        "title": "Meal"
      },
      "MenuResponse": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "hall": {
            "$ref": "#/components/schemas/Hall"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "meal": {
            "$ref": "#/components/schemas/Meal"
          },
          "status": {
            "type": "string",
            "enum": [
              "published",
              "not_published"
            ],
            "title": "Status"
          },
          "source_meal_names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Source Meal Names"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "type": "array",
            "title": "Items"
          },
          "revision": {
            "type": "string",
            "title": "Revision"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time",
            "title": "Fetched At"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "source_sha256": {
            "type": "string",
            "title": "Source Sha256"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "hall",
          "date",
          "meal",
          "status",
          "source_meal_names",
          "items",
          "revision",
          "fetched_at",
          "expires_at",
          "source_url",
          "source_sha256"
        ],
        "title": "MenuResponse"
      },
      "Serving": {
        "properties": {
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "weight_g": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Weight G"
          },
          "weight_basis": {
            "type": "string",
            "enum": [
              "source_mass_unit",
              "unknown"
            ],
            "title": "Weight Basis"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "quantity",
          "unit",
          "weight_basis"
        ],
        "title": "Serving"
      },
      "SessionResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "user": {
            "$ref": "#/components/schemas/AccountResponse"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "expires_at",
          "user"
        ],
        "title": "SessionResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}