# Generate a random URL-safe password; percent-encode reserved characters in database URLs.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
STALE_HOURS=36
SCRAPER_USER_AGENT=BerkeleyPlate/0.1 (contact: replace-with-your-support-url)
# Must exactly match the iOS App ID. Set both values to enable authentication.
APPLE_BUNDLE_ID=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
